{
  "rules": {
    "safeway": {
      "live": {
        ".read": true,
        ".write": "auth != null || true",
        "emergencyActive": {
          ".validate": "newData.isBoolean()"
        },
        "hazards": {
          "$zoneId": {
            ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'low' || newData.val() == 'high')"
          }
        },
        "crowds": {
          "$targetId": {
            ".validate": "newData.isString() && (newData.val() == 'Low' || newData.val() == 'Medium' || newData.val() == 'High')"
          }
        },
        "exits": {
          "$exitId": {
            "isOpen": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "sensors": {
          "$sensorId": {
            ".validate": "newData.hasChildren(['zone', 'hazardLevel', 'crowdLevel'])"
          }
        }
      }
    }
  }
}
